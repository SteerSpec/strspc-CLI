{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "SEC",
    "title": "Security",
    "description": "Security requirements on strspc and its CI, mapped to OWASP ASVS 5.0.0 L1."
  },
  "rule_set": {
    "version": "0.1.10",
    "timestamp": "2026-11-13T10:46:48Z",
    "hash": "blake3:e27d8875bd20529e2c22e74e892874fd4b2c22172e1423f8c3c54be817a21433"
  },
  "rules": [
    {
      "id": "SEC-001",
      "revision": 0,
      "state": "D",
      "body": "strspc MUST connect to an HTTP-based service over HTTPS only, unless the service is on a loopback address.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-13",
      "supersedes": null
    },
    {
      "id": "SEC-002",
      "revision": 0,
      "state": "D",
      "body": "strspc MUST run a subprocess as a fixed program with an argument list, never through a shell.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-13",
      "supersedes": null
    },
    {
      "id": "SEC-003",
      "revision": 0,
      "state": "D",
      "body": "CI MUST fail when govulncheck, run on every pull request and daily on develop, reports a vulnerability affecting the module's code.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-13",
      "supersedes": null
    },
    {
      "id": "SEC-004",
      "revision": 0,
      "state": "D",
      "body": "strspc MUST validate a rule file and a config file against their schemas before using their content.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-13",
      "supersedes": null
    },
    {
      "id": "SEC-005",
      "revision": 0,
      "state": "D",
      "body": "SECURITY.md MUST state the time frames for fixing a vulnerable dependency and for updating dependencies.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-13",
      "supersedes": null
    }
  ],
  "notes": [

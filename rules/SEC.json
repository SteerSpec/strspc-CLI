{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "SEC",
    "title": "Security",
    "description": "Security requirements on strspc and its CI, mapped to OWASP ASVS 5.0.0 L1."
  },
  "rule_set": {
    "version": "0.4.0",
    "timestamp": "2026-11-13T19:36:57Z",
    "hash": "blake3:46b42bb0a6700fcdef65e4b10992b29385b6287d9b37233b213a3f4f7ba5a18b"
  },
  "rules": [
    {
      "id": "SEC-001",
      "revision": 0,
      "state": "D",
      "body": "strspc MUST connect to an HTTP-based service over HTTPS only, unless the service is on a loopback address.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-13",
      "supersedes": null
    },
    {
      "id": "SEC-002",
      "revision": 0,
      "state": "P",
      "body": "strspc MUST run a subprocess as a fixed program with an argument list, never through a shell.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-13",
      "supersedes": null
    },
    {
      "id": "SEC-003",
      "revision": 0,
      "state": "P",
      "body": "CI MUST fail when a dependency has passed a time frame that SECURITY.md states.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-13",
      "supersedes": null
    },
    {
      "id": "SEC-004",
      "revision": 0,
      "state": "D",
      "body": "strspc MUST validate a rule file and a config file against their schemas before using their content.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-13",
      "supersedes": null
    },
    {
      "id": "SEC-005",
      "revision": 0,
      "state": "P",
      "body": "SECURITY.md MUST state risk-based time frames for fixing a vulnerable dependency and for updating dependencies in general.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-13",
      "supersedes": null
    }
  ],
  "notes": [
    {
      "id": "SEC-001/01",
      "rule_ref": "SEC-001",
      "type": "standard",
      "content": "owasp.asvs:V12.2.1",
      "added_by": "github:pleberre",
      "added_at": "2026-11-13",
      "revision": 0
    },
    {
      "id": "SEC-002/01",
      "rule_ref": "SEC-002",
      "type": "standard",
      "content": "owasp.asvs:V1.2.5",
      "added_by": "github:pleberre",
      "added_at": "2026-11-13",
      "revision": 0
    },
    {
      "id": "SEC-003/01",
      "rule_ref": "SEC-003",
      "type": "standard",
      "content": "owasp.asvs:V15.2.1",
      "added_by": "github:pleberre",
      "added_at": "2026-11-13",
      "revision": 0
    },
    {
      "id": "SEC-003/02",
      "rule_ref": "SEC-003",
      "type": "clarification",
      "content": "govulncheck on every pull request and daily on develop enforces the time frame for vulnerable dependencies; a daily check of `go list -m -u -json` release times enforces the update time frame.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-13",
      "revision": 0
    },
